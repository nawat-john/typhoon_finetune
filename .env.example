# Copy to .env and fill in. Used by scripts/restore_punct.py (Phase 2).
# Free tier = 20 requests/day/model PER GOOGLE PROJECT (shared by all keys in a
# project). To get more daily quota, add keys from DIFFERENT projects/accounts.
GEMINI_API_KEY=your-key-here
